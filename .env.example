# cutVideo runtime configuration. Copy to .env and adjust for your environment.
# No real credential belongs in this file or in the repository.

CUTVIDEO_ENV=development
CUTVIDEO_HTTP_ADDR=:8080
CUTVIDEO_HTTP_REQUEST_TIMEOUT=15s
CUTVIDEO_SHUTDOWN_GRACE=10s

# Relational store. SQLite is the default; point the DSN at a writable path.
CUTVIDEO_DATABASE_DSN=file:./data/cutvideo.db?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)
CUTVIDEO_RUN_MIGRATIONS=true

# Identity
CUTVIDEO_SESSION_TTL=12h
CUTVIDEO_PASSWORD_PEPPER=replace-me-with-a-deployment-secret

# Render farm
CUTVIDEO_RENDER_PRESETS=proxy_540p,web_1080p,master_2160p
CUTVIDEO_RENDER_LEASE_TTL=2m
CUTVIDEO_RENDER_MAX_ATTEMPTS=3
CUTVIDEO_RENDER_RETRY_BACKOFF=2s

# Background workers
CUTVIDEO_WORKER_ENABLED=true
CUTVIDEO_WORKER_CONCURRENCY=2
CUTVIDEO_WORKER_POLL_INTERVAL=250ms
# Must stay shorter than CUTVIDEO_RENDER_LEASE_TTL.
CUTVIDEO_WORKER_LEASE_RENEW_INTERVAL=30s

# Media ingest
CUTVIDEO_MEDIA_FORMATS=mov,mp4,mxf,prores,r3d
CUTVIDEO_ASSET_RETENTION=720h

# Logging
CUTVIDEO_LOG_LEVEL=info
CUTVIDEO_LOG_FORMAT=json

# First run bootstrap. Leave empty on an installed system.
CUTVIDEO_BOOTSTRAP_EMAIL=
CUTVIDEO_BOOTSTRAP_PASSWORD=
